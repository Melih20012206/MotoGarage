@model MotoGarage.Models.ServiceRecord

@{
    ViewData["Title"] = "Add Service Record";
}

<h1>Add Service Record</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="MotorcycleId" class="form-label">
                    Motorcycle
                </label>
                <select asp-for="MotorcycleId"
                        asp-items="ViewBag.Motorcycles"
                        class="form-select">
                    <option value="">Select a motorcycle</option>
                </select>
                <span asp-validation-for="MotorcycleId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ServiceType" class="form-label">
                    Service Type
                </label>
                <input asp-for="ServiceType" class="form-control" />
                <span asp-validation-for="ServiceType"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ServiceDate" class="form-label">
                    Service Date
                </label>
                <input asp-for="ServiceDate"
                       type="date"
                       class="form-control" />
                <span asp-validation-for="ServiceDate"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Price (€)</label>
                <input asp-for="Price"
                       type="number"
                       min="0"
                       max="100000"
                       step="0.01"
                       class="form-control" />
                <span asp-validation-for="Price"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Notes" class="form-label"></label>
                <textarea asp-for="Notes"
                          rows="3"
                          class="form-control"></textarea>
                <span asp-validation-for="Notes"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}