@model MotoGarage.Models.ServiceRecord

@{
    ViewData["Title"] = "Delete Service Record";
}

<h1>Delete Service Record</h1>

<p>Are you sure you want to delete this service record?</p>

<dl class="row">
    <dt class="col-sm-3">Motorcycle</dt>
    <dd class="col-sm-9">
        @Model.Motorcycle.Brand @Model.Motorcycle.Model
        (#@Model.MotorcycleId)
    </dd>

    <dt class="col-sm-3">Service</dt>
    <dd class="col-sm-9">@Model.ServiceType</dd>

    <dt class="col-sm-3">Date</dt>
    <dd class="col-sm-9">
        @Model.ServiceDate.ToString("dd.MM.yyyy")
    </dd>

    <dt class="col-sm-3">Price</dt>
    <dd class="col-sm-9">@Model.Price.ToString("F2") €</dd>

    <dt class="col-sm-3">Notes</dt>
    <dd class="col-sm-9">@Model.Notes</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>