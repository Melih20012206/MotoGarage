@model MotoGarage.Models.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-welcome mb-4">
    <span class="dashboard-label">WORKSHOP DASHBOARD</span>
    <h1 class="display-4">Welcome to MotoGarage</h1>
    <p class="lead mb-0">
        Your garage, organized. Manage customers, motorcycles
        and service history in one place.
    </p>
</div>

<div class="row g-3">
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Customers</h2>
                <p class="display-6">@Model.CustomersCount</p>
                <a asp-controller="Customers"
                   asp-action="Index"
                   class="btn btn-primary">
                    View Customers
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Motorcycles</h2>
                <p class="display-6">@Model.MotorcyclesCount</p>
                <a asp-controller="Motorcycles"
                   asp-action="Index"
                   class="btn btn-primary">
                    View Motorcycles
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Service Records</h2>
                <p class="display-6">@Model.ServiceRecordsCount</p>
                <a asp-controller="ServiceRecords"
                   asp-action="Index"
                   class="btn btn-primary">
                    View Service History
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-6 col-lg-3">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <h2 class="h5">Today's Service Value</h2>
                <p class="fs-2">
                    @Model.TodayServiceValue.ToString("F2") €
                </p>
                <p class="text-muted mb-0">
                    Value of services dated today.
                </p>
            </div>
        </div>
    </div>
</div>