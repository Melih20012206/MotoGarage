@model IEnumerable<MotoGarage.Models.Motorcycle>

@{
    ViewData["Title"] = "Motorcycles";
    string? searchTerm = ViewBag.SearchTerm as string;
}

<div class="container mt-4">
    <h1>Motorcycle Garage</h1>

    <p>Manage motorcycles registered in MotoGarage.</p>

    <p>
        <a asp-action="Create" class="btn btn-primary">
            Add Motorcycle
        </a>
    </p>

    <form asp-action="Index" method="get" class="mb-4">
        <label for="searchTerm" class="form-label">
            Search by brand or model
        </label>

        <div class="row g-2">
            <div class="col-12 col-md-8">
                <input type="search"
                       id="searchTerm"
                       name="searchTerm"
                       value="@searchTerm"
                       class="form-control"
                       placeholder="Example: Honda or CBR" />
            </div>

            <div class="col-12 col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    Search
                </button>

                <a asp-action="Index" class="btn btn-outline-light">
                    Clear
                </a>
            </div>
        </div>
    </form>

    @if (!Model.Any())
    {
        <p>
            @(string.IsNullOrWhiteSpace(searchTerm)
                    ? "No motorcycles registered yet."
                    : "No motorcycles match your search.")
    </p>
        }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Brand</th>
                        <th>Model</th>
                        <th>Year</th>
                        <th>Engine</th>
                        <th>Kilometers</th>
                        <th>Owner</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var motorcycle in Model)
                    {
                        <tr>
                            <td>@motorcycle.Brand</td>
                            <td>@motorcycle.Model</td>
                            <td>@motorcycle.Year</td>
                            <td>@motorcycle.EngineCapacity cc</td>
                            <td>@motorcycle.Kilometers km</td>

                            <td>
                                @motorcycle.Customer?.FirstName
                                @motorcycle.Customer?.LastName
                            </td>

                            <td>
                                <a asp-action="Details"
                                   asp-route-id="@motorcycle.Id"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@motorcycle.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@motorcycle.Id"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>