@model MotoGarage.Models.Motorcycle

@{
    ViewData["Title"] = "Motorcycle Details";
}

<div class="container mt-4">
    <h1>Motorcycle Details</h1>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">Brand</dt>
        <dd class="col-sm-9">@Model.Brand</dd>

        <dt class="col-sm-3">Model</dt>
        <dd class="col-sm-9">@Model.Model</dd>

        <dt class="col-sm-3">Year</dt>
        <dd class="col-sm-9">@Model.Year</dd>

        <dt class="col-sm-3">Engine Capacity</dt>
        <dd class="col-sm-9">@Model.EngineCapacity cc</dd>

        <dt class="col-sm-3">Kilometers</dt>
        <dd class="col-sm-9">@Model.Kilometers km</dd>

        <dt class="col-sm-3">Owner</dt>
        <dd class="col-sm-9">
            @Model.Customer.FirstName @Model.Customer.LastName
        </dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>
    </dl>
    <hr />

    <h2>Service History</h2>

    @if (!Model.ServiceRecords.Any())
    {
        <p>No service records for this motorcycle yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Service</th>
                        <th>Date</th>
                        <th>Price (€)</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var record in Model.ServiceRecords
                                    .OrderByDescending(s => s.ServiceDate))
                    {
                        <tr>
                            <td>@record.ServiceType</td>
                            <td>@record.ServiceDate.ToString("dd.MM.yyyy")</td>
                            <td>@record.Price.ToString("F2") €</td>
                            <td>@record.Notes</td>
                            <td>
                                <a asp-controller="ServiceRecords"
                                   asp-action="Edit"
                                   asp-route-id="@record.Id"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>
                                <a asp-controller="ServiceRecords"
                                   asp-action="Delete"
                                   asp-route-id="@record.Id"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p>
            <strong>Total service cost:</strong>
            @(Model.ServiceRecords.Sum(s => s.Price).ToString("F2")) €
        </p>
    }

    <a asp-action="Index" class="btn btn-secondary">
        Back to Motorcycles
    </a>
</div>