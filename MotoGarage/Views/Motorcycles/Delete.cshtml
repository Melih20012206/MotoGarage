@model MotoGarage.Models.Motorcycle

@{
    ViewData["Title"] = "Delete Motorcycle";
}

<div class="container mt-4">
    <h1>Delete Motorcycle</h1>

    <div class="alert alert-danger">
        Are you sure you want to delete this motorcycle?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Brand</dt>
        <dd class="col-sm-9">@Model.Brand</dd>

        <dt class="col-sm-3">Model</dt>
        <dd class="col-sm-9">@Model.Model</dd>

        <dt class="col-sm-3">Year</dt>
        <dd class="col-sm-9">@Model.Year</dd>

        <dt class="col-sm-3">Engine Capacity</dt>
        <dd class="col-sm-9">@Model.EngineCapacity cc</dd>

        <dt class="col-sm-3">Kilometers</dt>
        <dd class="col-sm-9">@Model.Kilometers km</dd>

        <dt class="col-sm-3">Owner</dt>
        <dd class="col-sm-9">
            @Model.Customer.FirstName @Model.Customer.LastName
        </dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>